# the server the tests talk to (the app must see the same one)
E2E_API_URL=http://127.0.0.1:7202
# a READ-ONLY user of the local database (never a deployed one)
E2E_DATABASE_URL=
# only for pnpm test:run: the secret of the number server (the same value as on the web server, 32 characters or more)
TEST_RUN_SECRET=
# the number server, when it is not E2E_API_URL
# TEST_RUN_SERVER=
# the name of the device in the number server (rwa-mobile when empty)
# TEST_RUN_DEVICE=
