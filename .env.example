# Server address is a setting. Do not write localhost in code.
# Android emulator: the host PC is 10.0.2.2 (localhost is the emulator itself).
# Real device: use the LAN address of the PC.
#
# 7202 = Express API, reached directly. Checked from the Android emulator.
# 7201 = web dev server with the /api proxy. It works from the emulator only
#        if the web dev server listens on IPv4. Vite listens on ::1 (IPv6)
#        only by default, so the emulator could not reach it.
API_BASE_URL=http://10.0.2.2:7202/api
