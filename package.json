{
  "name": "cypress-realworld-for-personal-portfolio-mobile",
  "private": true,
  "license": "MIT",
  "scripts": {
    "app:get": "cd apps/mobile && flutter pub get",
    "app:analyze": "cd apps/mobile && flutter analyze",
    "app:test": "cd apps/mobile && flutter test",
    "app:run": "cd apps/mobile && flutter run --dart-define-from-file=../../.env",
    "app:build:apk": "cd apps/mobile && flutter build apk --debug --dart-define-from-file=../../.env",
    "e2e": "pnpm --filter e2e test"
  }
}
